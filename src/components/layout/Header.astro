---
import LangToggle from "@/components/LangToggle.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { DEFAULT_LOCALE, type Locale, localizePath } from "@/i18n";
import { menuLinks } from "@/site.config";
import { siteConfig } from "../../site.config";

interface Props {
	locale: Locale;
	langToggleHref: string;
}

const { locale = DEFAULT_LOCALE, langToggleHref } = Astro.props;

// Keep navigation within the current locale: prefix every menu/home link with /en
// on English pages. menuLinks titles stay as-is (already English-language labels).
const homeHref = localizePath("/", locale);
const localizedLinks = menuLinks.map((link) => ({
	...link,
	path: localizePath(link.path, locale),
}));
---

