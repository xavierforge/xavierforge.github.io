<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>

<style>
	.anvil {
		--f-top: #8f969e;
		--f-left: #747a82;
		--f-right: #595e66;
		--f-accent: #45474c;
	}
	.anvil polygon {
		transition: fill 0.3s ease;
	}
	.anvil .f-top {
		fill: var(--f-top);
	}
	.anvil .f-left {
		fill: var(--f-left);
	}
	.anvil .f-right {
		fill: var(--f-right);
	}
	.anvil .f-accent {
		fill: var(--f-accent);
	}

	/* hover: steel → rusted iron */
	.logo-link:hover .anvil,
	.logo-link:focus-visible .anvil {
		--f-top: #c9803f;
		--f-left: #9c5a2d;
		--f-right: #713d1d;
		--f-accent: #844a24;
		animation: forge-flicker 2.8s ease-in-out infinite;
	}

	/* touch devices can't hover → run the full forge effect by default:
	   rusted iron + firelight flicker + flying sparks */
	@media (hover: none) {
		.anvil {
			--f-top: #c9803f;
			--f-left: #9c5a2d;
			--f-right: #713d1d;
			--f-accent: #844a24;
			animation: forge-flicker 2.8s ease-in-out infinite;
		}
		.logo-sparks .spark {
			animation: spark-fly 0.7s ease-out infinite;
		}
	}

	/* hot-metal firelight shimmer while hovered */
	@keyframes forge-flicker {
		0% {
			filter: brightness(1) saturate(1);
		}
		15% {
			filter: brightness(1.13) saturate(1.08);
		}
		30% {
			filter: brightness(0.97) saturate(1);
		}
		45% {
			filter: brightness(1.09) saturate(1.05);
		}
		60% {
			filter: brightness(1) saturate(1);
		}
		78% {
			filter: brightness(1.15) saturate(1.1);
		}
		90% {
			filter: brightness(0.98) saturate(1);
		}
		100% {
			filter: brightness(1.05) saturate(1.03);
		}
	}

	.logo-sparks .spark {
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		will-change: transform, opacity;
	}

	.logo-link:hover .logo-sparks .spark,
	.logo-link:focus-visible .logo-sparks .spark {
		animation: spark-fly 0.7s ease-out infinite;
	}

	@keyframes spark-fly {
		0% {
			opacity: 0;
			transform: translate(0, 0) scale(0.3);
		}
		12% {
			opacity: 1;
		}
		65% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translate(var(--dx), var(--dy)) scale(1.55);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-link:hover .anvil,
		.logo-link:focus-visible .anvil,
		.logo-link:hover .logo-sparks .spark,
		.logo-link:focus-visible .logo-sparks .spark,
		.anvil,
		.logo-sparks .spark {
			animation: none;
		}
	}
</style>
