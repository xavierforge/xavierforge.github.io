---
// Header control for the site-wide content language. Mirrors ThemeToggle.astro:
// the button dispatches a `lang-change` event that LangProvider.astro handles
// (sets <html data-lang> + persists to localStorage). The label is driven by the
// same global data-lang CSS — no JS, no flash — and shows the language you'll
// switch *to* (an invitation that helps English visitors discover the toggle).
---

<lang-toggle class="ms-2 sm:ms-4">
	<button
		aria-label="Switch language / 切換語言"
		class="hover:text-accent relative flex h-9 w-9 cursor-pointer items-center justify-center text-sm font-semibold"
		type="button"
	>
		<span aria-hidden="true" data-lang="zh">EN</span>
		<span aria-hidden="true" data-lang="en">中</span>
	</button>
</lang-toggle>

<script>
	class LangToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector<HTMLButtonElement>("button");
			button?.addEventListener("click", () => {
				const current = document.documentElement.getAttribute("data-lang") === "en" ? "en" : "zh";
				const next = current === "en" ? "zh" : "en";
				document.dispatchEvent(new CustomEvent("lang-change", { detail: { lang: next } }));
			});
		}
	}

	customElements.define("lang-toggle", LangToggle);
</script>
