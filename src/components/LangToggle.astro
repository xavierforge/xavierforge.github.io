---
// Header language switch. With the bilingual URL split, switching language means
// navigating to the alternate-locale URL (the Chinese post at /posts/<slug>/ vs the
// English one at /en/posts/<slug>/), not toggling CSS. It's a plain <a> — works
// without JS — and the site's `@view-transition { navigation: auto }` rule
// (src/styles/global.css) cross-fades the same-origin navigation automatically.
//
// The label + target are rendered server-side per page (no flash). `href` is the
// alternate-locale URL when one exists for this page; Base.astro falls back to the
// other locale's home for pages without a counterpart.
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n";

interface Props {
	locale: Locale;
	href: string;
}

const { locale = DEFAULT_LOCALE, href } = Astro.props;
const { toggleLabel, toggleAriaLabel } = LOCALES[locale];
---

<a
	aria-label={toggleAriaLabel}
	class="hover:text-accent relative ms-2 flex h-9 w-9 cursor-pointer items-center justify-center text-sm font-semibold transition-transform duration-150 motion-safe:hover:scale-110 motion-safe:active:scale-90 sm:ms-4"
	href={href}
>
	<span aria-hidden="true">{toggleLabel}</span>
</a>
