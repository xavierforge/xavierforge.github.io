---
import type { CollectionEntry } from "astro:content";
import PinnedPostCard from "@/components/blog/PinnedPostCard.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import { buildAlternates, localizePath } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const alternates = buildAlternates({
	zh: localizePath("/", "zh-Hant"),
	en: localizePath("/", "en"),
});

const MAX_POSTS = 30;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();
---

<PageLayout
	meta={{
		title: "Home",
		description:
			"資料工程師，鍛造 AI Agent、MLOps 工作流，以及 Rust 於 ML 領域的工具。著有《從 Pythonista 到 Rustacean》。",
		locale: "zh-Hant",
		alternates,
	}}
>
	<section>
		<h1 class="title mb-6">嗨 陌生人！我是 Xavier (顏志穎)</h1>
		<p class="mb-4">
			資料工程師，鍛造 AI Agent、MLOps 工作流，以及 Rust 於 ML 領域的工具。
		</p>
		<p class="mb-4">著有《從 Pythonista 到 Rustacean》。</p>
		<SocialList />
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Pinned Posts</h2>
				<ul
					class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
					role="list"
				>
					{pinnedPosts.map((p) => (
						<li>
							<PinnedPostCard post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Posts</a></h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
