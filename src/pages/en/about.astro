---
import { Image } from "astro:assets";

import aboutPhoto from "@/assets/about.png";
import { buildAlternates, localizePath } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"About Xavier (Chih-Ying) Yen — data engineer forging AI agents, MLOps pipelines, and Rust tooling for ML; author of From Pythonista to Rustacean.",
	title: "About",
	locale: "en" as const,
	alternates: buildAlternates({
		zh: localizePath("/about/", "zh-Hant"),
		en: localizePath("/about/", "en"),
	}),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-8">About Me</h1>
	<Image
		alt="Xavier (Chih-Ying) Yen"
		class="border-special-light mb-8 h-40 w-40 rounded-full border object-cover object-[center_25%]"
		densities={[1.5, 2]}
		src={aboutPhoto}
		width={160}
	/>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi stranger, I’m Xavier — a data and machine learning engineer, and the
			author of <em>From Pythonista to Rustacean: A Data Practitioner’s First
			Guide to Rust</em> (《從 Pythonista 到 Rustacean：資料從業者的第一本 Rust
			指南》), which walks Python-rooted data professionals into the Rust world,
			covering Rust fundamentals, PyO3 integration, and hands-on AI model
			training with Candle and Burn.
		</p>
		<p>
			I believe that crafting a great data solution is much like forging a fine
			tool: choosing the right material, controlling the heat, and hammering it
			again and again until something genuinely useful is tempered into shape.
			<em>Xavier’s Data Forge</em> is my aspiration toward that philosophy —
			treating raw, messy data as iron ore waiting to be smelted, and refining
			it with a craftsman’s discipline into reliable insights and systems.
		</p>
		<p>
			With over five years of hands-on experience across the materials and
			telecom industries, I’ve built end-to-end machine learning solutions
			ranging from discovering new materials with Bayesian Optimization to
			catching production-line defects with YOLO before they turn into real
			problems.
		</p>
		<p>
			More recently I’ve extended my focus into the Rust ML ecosystem and remain
			an active open-source contributor — most notably on <a
			href="https://github.com/gi-dellav/zerostack">zerostack</a>, a lightweight,
			memory-efficient coding agent harness written in Rust.<br />From writing
			technical series and collaborating in the open, to shipping my first book,
			I’m driven by a lifelong appetite for learning, always curious about new
			tools and ideas, and always looking for a more effective way to solve the
			problem on the anvil.
		</p>
	</div>
</PageLayout>
