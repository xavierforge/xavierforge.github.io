---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { buildAlternates, localizePath } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

// Projects have no per-language variants, so the English portfolio shows the same
// project data with English chrome.
const projects = (await getCollection("project")).sort((a, b) => a.data.order - b.data.order);

const meta = {
	description: "Selected projects by Xavier (Chih-Ying) Yen.",
	title: "Portfolio",
	locale: "en" as const,
	alternates: buildAlternates({
		zh: localizePath("/portfolio/", "zh-Hant"),
		en: localizePath("/portfolio/", "en"),
	}),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Portfolio</h1>
	<ul class="grid grid-cols-1 gap-6 sm:grid-cols-2" role="list">
		{
			projects.map((project) => (
				<li>
					<a class="group block" href={project.data.link} rel="noreferrer" target="_blank">
						<article class="border-special-light overflow-hidden rounded-lg border transition-colors group-hover:border-accent">
							<div class="bg-special-lighter aspect-video">
								{project.data.coverImage ? (
									<Image
										alt={project.data.coverImage.alt}
										class="h-full w-full object-cover"
										height={240}
										src={project.data.coverImage.src}
										width={420}
									/>
								) : (
									<div class="text-muted flex h-full w-full items-center justify-center text-2xl">
										{project.data.title.slice(0, 1)}
									</div>
								)}
							</div>
							<div class="p-4">
								<h2 class="title text-accent-2 mb-1 text-lg font-semibold group-hover:underline">
									{project.data.title}
								</h2>
								<p class="text-muted text-sm">{project.data.description}</p>
							</div>
						</article>
					</a>
				</li>
			))
		}
	</ul>
</PageLayout>
