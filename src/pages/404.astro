---
import PageLayout from "@/layouts/Base.astro";

// One 404 serves every path (GitHub Pages can't route a per-locale 404), so the
// copy is bilingual and the links point at the default-locale entry points.
const meta = {
	description: "Page not found — 找不到這個頁面。",
	title: "404 — Page not found",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">404</h1>
	<p class="mb-2 text-lg">This page got lost on the anvil. Let's get you back.</p>
	<p class="text-muted mb-10">這個頁面好像被遺落在鐵砧上了，幫你找條路回去。</p>
	<ul class="space-y-2">
		<li><a class="cactus-link" href="/">Home / 首頁</a></li>
		<li><a class="cactus-link" href="/posts/">Blog / 文章列表</a></li>
		<li><a class="cactus-link" href="/tags/">Tags / 標籤</a></li>
		<li><a class="cactus-link" href="/en/">English site</a></li>
	</ul>
</PageLayout>
