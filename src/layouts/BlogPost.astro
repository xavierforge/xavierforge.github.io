---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import Comments from "@/components/Comments.astro";
import {
	type Alternate,
	canonicalSlug,
	DEFAULT_LOCALE,
	LOCALES,
	type Locale,
	localizePath,
	rssPath,
} from "@/i18n";
import { siteConfig } from "@/site.config";

import BaseLayout from "./Base.astro";

// KaTeX styles for math rendered by remark-math + rehype-katex
import "katex/dist/katex.min.css";

interface Props {
	post: CollectionEntry<"post">;
	locale?: Locale;
	/** hreflang set for this post (self + the other language if it exists). */
	alternates?: Alternate[];
}

const { post, locale = DEFAULT_LOCALE, alternates } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.jpg`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;

// Shared Giscus thread across both languages: the canonical slug (`foo`) is the
// same for the zh post (`foo`) and its English companion (`foo.en`).
const commentTerm = canonicalSlug(post.id);

// schema.org Article structured data (P4) — rich-result eligibility. `inLanguage`
// tracks the page locale; image/author/publisher are resolved to absolute URLs.
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: title,
	description,
	image: new URL(socialImage, Astro.site).href,
	datePublished: publishDate.toISOString(),
	dateModified: (updatedDate ?? publishDate).toISOString(),
	author: {
		"@type": "Person",
		name: siteConfig.author,
		url: new URL(localizePath("/about/", locale), Astro.site).href,
	},
	publisher: {
		"@type": "Organization",
		name: siteConfig.title,
		logo: { "@type": "ImageObject", url: new URL("/logo.png", Astro.site).href },
	},
	inLanguage: LOCALES[locale].htmlLang,
};
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
		locale,
		alternates,
		rssHref: rssPath(locale),
		jsonLd,
	}}
>
	<article class="grow break-words" data-pagefind-body>
		<div id="blog-hero" class="mb-12">
			<Masthead content={post} readingTime={readingTime} locale={locale} />
		</div>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{!!headings.length && <TOC headings={headings} />}
			<div
				class="prose w-full max-w-none flex-1 prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-muted prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
				{/* This page renders a single language; the /en/ route supplies the English body. */}
				<slot />
				<WebMentions />
			</div>
		</div>
		<Comments term={commentTerm} />
	</article>
	<button
		class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// only show the scroll to top button when the heading is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
