---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { DEFAULT_LOCALE, LOCALES, localizePath } from "@/i18n";
import { analyticsConfig, siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title, alternates, rssHref },
} = Astro.props;

const locale = Astro.props.meta.locale ?? DEFAULT_LOCALE;

// Language-toggle target: the alternate-locale URL for this page if it exists,
// else the other locale's home. Reads the hreflang set we already build for SEO.
const otherLocale = locale === "en" ? "zh-Hant" : "en";
const otherHreflang = otherLocale === "en" ? "en" : "zh-Hant";
const langToggleHref =
	alternates?.find((a) => a.hreflang === otherHreflang)?.href ?? localizePath("/", otherLocale);

// Only count real visitors: load GoatCounter on the deployed site, not in dev/preview.
const goatCounterUrl =
	import.meta.env.PROD && analyticsConfig.code
		? `https://${analyticsConfig.code}.goatcounter.com/count`
		: null;
---

<html class="scroll-smooth" lang={LOCALES[locale].htmlLang}>
	<head>
		<BaseHead
			articleDate={articleDate}
			description={description}
			ogImage={ogImage}
			title={title}
			locale={locale}
			alternates={alternates}
			rssHref={rssHref}
		/>
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-5xl flex-col px-4 pt-16 font-mono text-sm font-normal tracking-wide antialiased sm:px-8"
	>
		<SkipLink />
		<Header locale={locale} langToggleHref={langToggleHref} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
		{
			goatCounterUrl && (
				<script is:inline async data-goatcounter={goatCounterUrl} src="//gc.zgo.at/count.js" />
			)
		}
	</body>
</html>
